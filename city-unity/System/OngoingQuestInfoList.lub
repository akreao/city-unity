-- City Unity quest text in English, for the city-unity mod (Ragnarok Offline).
-- Every entry is the iRO client's own text (patched 2026-10-07). "iRO, corrected" entries
-- only rename the Union Token to the Union Insignia, the item's name in the iRO item table
-- and on the server. ASCII only: the client reads this table in its own codepage.

QuestInfoList = {
	[12370] = { -- iRO, corrected
		Title = "Member of Union",
		Description = {
			"You will now engage in hunting as a member of the Midgard City Union. You have a chance to obtain a Union Insignia while hunting.",
		},
		Summary = "A member of the Midgard Union",
	},
	[12371] = { -- official iRO
		Title = "Today's Investment Finished",
		Description = {
			"You have already invested in a city today. You can invest again after the reset at 4:00 AM.",
		},
		Summary = "Resets at 4 AM",
		CoolTimeQuest = 1,
	},
	[5470] = { -- official iRO
		Title = "(Wanted) Pending",
		Description = {
			"There are no newly registered bounty requests on the City Merchants' Union bulletin board. It seems that requests are updated every Wednesday at 4:00 AM.",
		},
		Summary = "Resets Wednesday at 4:00 AM",
		CoolTimeQuest = 1,
	},
